# ローカル開発でだけtrueにする。本番環境では設定しない。
LOCAL_DEVELOPMENT=true

# Admin専用・非保存のレジ操作デモ。Renderで明示的に有効化するまではfalse。
REGISTER_V3_PUBLIC_DEMO_ENABLED=false

# Phase 5B: Admin専用の切替事前監査と独自商品・レシピ対応画面。migration後に別途明示設定。
REGISTER_V3_READINESS_ENABLED=false
REGISTER_V3_PRODUCTION_ENABLED=false
REGISTER_V3_CUTOVER_ENABLED=false
REGISTER_V3_RECOVERY_ENABLED=false
REGISTER_V3_OFFLINE_MODE_ENABLED=false

GEMINI_API_KEY=

SECRET_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Guest Demoのローカル動作確認用rate limit
GUEST_CREATION_RATE_LIMIT_MAX_ATTEMPTS=5
GUEST_CREATION_RATE_LIMIT_WINDOW_SECONDS=60

# 現在天気と過去天気の地点（未設定時は取得不可）。広島市中心部の例: 34.4 / 132.45。
# 本番の無料予報: WEATHER_API_MODE=met_norway、APIキー不要（過去天気の取り込みには非対応）。
# Open-Meteo: 無償APIはローカルの非商用利用に限定。商用運用は契約とAPIキーが必要。
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_API_MODE=
WEATHER_API_KEY=
# 表示する店舗の地域名。未設定なら設定座標を表示。
WEATHER_LOCATION_NAME=

# Puoppo側のGoogle認証・許可メール・日次上限を確認するまでは false。
PUOPPO_INTEGRATION_ENABLED=false
